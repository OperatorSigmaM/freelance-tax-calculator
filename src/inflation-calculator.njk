<script>
    function setInflationRate(rate) {
        document.getElementById('inflationRate').value = rate;
        
        // Update active button
        document.querySelectorAll('.preset-btn').forEach(btn => btn.classList.remove('active'));
        event.target.classList.add('active');
    }
    
    function calculateInflation() {
        const currentAmount = parseFloat(document.getElementById('currentAmount').value) || 0;
        const years = parseInt(document.getElementById('years').value) || 0;
        const inflationRate = parseFloat(document.getElementById('inflationRate').value) || 0;
        
        if (currentAmount <= 0 || years <= 0 || inflationRate < 0) {
            alert('Please enter valid values');
            return;
        }
        
        // Calculate future purchasing power
        // Formula: PV = FV / (1 + r)^n
        const rate = inflationRate / 100;
        const futurePurchasingPower = currentAmount / Math.pow(1 + rate, years);
        
        // Calculate how much you'd need in the future to equal today's purchasing power
        const amountNeeded = currentAmount * Math.pow(1 + rate, years);
        
        // Calculate loss percentage
        const lossPercentage = ((currentAmount - futurePurchasingPower) / currentAmount) * 100;
        
        // Calculate yearly values for chart
        const yearlyValues = [];
        for (let year = 0; year <= years; year += Math.ceil(years / 10)) {
            const value = currentAmount / Math.pow(1 + rate, year);
            yearlyValues.push({ year, value });
        }
        
        displayResults(currentAmount, futurePurchasingPower, amountNeeded, lossPercentage, years, inflationRate, yearlyValues);
    }
    
    function displayResults(current, future, needed, loss, years, rate, yearlyValues) {
        // Alert message
        let alertMsg = '';
        if (loss < 20) {
            alertMsg = `With ${rate}% inflation over ${years} years, your money will lose ${loss.toFixed(1)}% of its purchasing power. This is relatively modest but still significant.`;
        } else if (loss < 50) {
            alertMsg = `Warning: Your $${current.toLocaleString()} will only buy what $${future.toLocaleString('en-US', {maximumFractionDigits: 0})} buys today. That's a ${loss.toFixed(1)}% loss in purchasing power.`;
        } else if (loss < 75) {
            alertMsg = `Critical: Your money will lose over half its value! $${current.toLocaleString()} will only buy what $${future.toLocaleString('en-US', {maximumFractionDigits: 0})} buys today.`;
        } else {
            alertMsg = `Severe inflation impact: Your $${current.toLocaleString()} will be worth only $${future.toLocaleString('en-US', {maximumFractionDigits: 0})} in today's purchasing power - a ${loss.toFixed(1)}% loss!`;
        }
        document.getElementById('alertMessage').textContent = alertMsg;
        
        // Comparison cards
        document.getElementById('todayValue').textContent = '$' + current.toLocaleString('en-US', {maximumFractionDigits: 0});
        document.getElementById('futureValue').textContent = '$' + future.toLocaleString('en-US', {maximumFractionDigits: 0});
        document.getElementById('yearsLabel').textContent = years;
        
        // Loss indicator
        document.getElementById('lossPercentage').textContent = loss.toFixed(1) + '%';
        
        // Breakdown
        document.getElementById('breakdownOriginal').textContent = '$' + current.toLocaleString('en-US', {maximumFractionDigits: 0});
        document.getElementById('breakdownRate').textContent = rate + '%';
        document.getElementById('breakdownYears').textContent = years + ' years';
        document.getElementById('breakdownPower').textContent = '$' + future.toLocaleString('en-US', {maximumFractionDigits: 0});
        document.getElementById('breakdownNeeded').textContent = '$' + needed.toLocaleString('en-US', {maximumFractionDigits: 0});
        
        // Create chart
        createChart(yearlyValues);
        
        document.getElementById('results').classList.add('show');
    }
    
    function createChart(yearlyValues) {
        const chartBars = document.getElementById('chartBars');
        chartBars.innerHTML = '';
        
        const maxValue = yearlyValues[0].value;
        
        yearlyValues.forEach((data, index) => {
            const container = document.createElement('div');
            container.className = 'chart-bar-container';
            
            const bar = document.createElement('div');
            bar.className = 'chart-bar declining';
            const heightPercent = (data.value / maxValue) * 100;
            bar.style.height = heightPercent + '%';
            
            const label = document.createElement('div');
            label.className = 'chart-label';
            label.textContent = 'Year ' + data.year;
            
            container.appendChild(bar);
            container.appendChild(label);
            chartBars.appendChild(container);
        });
    }
</script>

